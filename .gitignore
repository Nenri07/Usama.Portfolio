# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client source deck � contains private financials, never commit
portfolio.pdf
PURO PROFILE SHORT-29-09-25.pdf
PURO_Portfolio.pdf
# Never commit source PDFs (may contain private financials/PII)
*.pdf

# Raw source imagery — keep only the optimized copies referenced by the app.
# WhatsApp-named originals (spaces/parens) are converted to work-NN.webp.
public/puro/work/WhatsApp Image*
# Source certificate PNGs are optimized to cert-NN.webp; keep sources local.
public/puro/certificates/[0-9][0-9]_*.png

# Qasim event source deck — image FILENAMES + MANIFEST.csv embed PRIVATE
# financial data (revenue/cost/net_profit). NEVER commit; the app serves only
# the sanitized copies produced under public/qasim/ by
# scripts/normalize-qasim-images.mjs.
public/qasim-khalid-projects/
